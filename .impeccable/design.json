  "narrative": {
    "northStar": "The Wallet Workspace",
    "overview": "The Wallet Workspace is a light interface for local personal finance on Android and iOS. A neutral canvas and white rounded surfaces support soft pink-to-violet balance panels, near-black primary actions, and prominent amounts. Short labels and recognizable category icons keep everyday entry quiet and direct.\n\nFlutter Material 3 supplies native interaction, focus, validation, and navigation behavior. The original wallet-and-bars identity uses matching violet and pink. This record follows the implemented lib/ui system and the user\u2019s 3 October 2026 reference, which supersedes the earlier blue direction.",
    "keyCharacteristics": [
      "Light neutral canvas, white surfaces, and soft gradient financial focal points.",
      "Large exact amounts and compact supporting metadata.",
      "White mobile navigation with a dark selected circle and separate dark add action.",
      "Explicit category hierarchy, recognizable icons, and adaptive selection layouts."
    ],
    "rules": [
      {
        "name": "The Cash Direction Rule",
        "body": "Cash entering the wallet uses green; cash leaving uses red. Keep the signed amount and explicit loan movement description together, so color never carries the meaning alone.",
        "section": "colors"
      },
      {
        "name": "The Exact Amount Rule",
