      "html": "<nav class=\"ds-nav\" aria-label=\"Wallet workspace\"><button class=\"ds-destination\" aria-current=\"page\"><span class=\"ds-indicator\"><svg width=\"23\" height=\"23\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" aria-hidden=\"true\"><path d=\"M3 10 12 3l9 7v11h-6v-7H9v7H3Z\"/></svg></span><span>Overview</span></button><button class=\"ds-destination\"><span class=\"ds-indicator\"><svg width=\"23\" height=\"23\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" aria-hidden=\"true\"><path d=\"M6 3h12v18l-3-2-3 2-3-2-3 2ZM9 7h6M9 11h6M9 15h6\"/></svg></span><span>Transactions</span></button><button class=\"ds-destination\"><span class=\"ds-indicator\"><svg width=\"23\" height=\"23\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" aria-hidden=\"true\"><path d=\"M3 6h7l2 2h9v12H3Z\"/></svg></span><span>Groups</span></button><button class=\"ds-destination\"><span class=\"ds-indicator\"><svg width=\"23\" height=\"23\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" aria-hidden=\"true\"><path d=\"m2 9 5-5 5 2 5-2 5 5-4 4-4-4-3 2-4-3-3 5m3 0 7 7 6-6\"/></svg></span><span>Lending</span></button></nav>",
